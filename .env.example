# Optional: MiniMax OpenAI-compatible Chat Completions
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_CHAT_MODEL=MiniMax-M3

CHROMA_DB_DIR=chroma_db
CHROMA_COLLECTION_NAME=liquid_cooling_industry
