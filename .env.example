# Embedding provider: local | openai
# local is free and recommended for this demo; it downloads a sentence-transformers model on first use.
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Optional: only needed if EMBEDDING_PROVIDER=openai or LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Chat model provider: openai | deepseek | minimax
LLM_PROVIDER=deepseek
OPENAI_CHAT_MODEL=gpt-4o-mini

# Optional: DeepSeek OpenAI-compatible Chat Completions
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash

# Optional: MiniMax OpenAI-compatible Chat Completions
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_CHAT_MODEL=MiniMax-M3

CHROMA_DB_DIR=chroma_db
CHROMA_COLLECTION_NAME=liquid_cooling_industry
